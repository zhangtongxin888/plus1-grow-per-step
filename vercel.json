{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/beginner-guide.html", "destination": "/beginner-guide", "permanent": true },
    { "source": "/progression.html", "destination": "/progression", "permanent": true },
    { "source": "/mistakes.html", "destination": "/mistakes", "permanent": true },
    { "source": "/faq.html", "destination": "/faq", "permanent": true },
    { "source": "/sources.html", "destination": "/sources", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.plus1growperstep.wiki" }],
      "destination": "https://plus1growperstep.wiki/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/beginner-guide", "destination": "/beginner-guide.html" },
    { "source": "/progression", "destination": "/progression.html" },
    { "source": "/mistakes", "destination": "/mistakes.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/sources", "destination": "/sources.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob: data:; style-src 'self' 'unsafe-inline' https: blob: data:; img-src 'self' data: blob: https:; font-src 'self' data: blob: https:; connect-src 'self' https: wss: blob:; frame-src https: blob: data:; child-src https: blob: data:; worker-src 'self' https: blob: data:; media-src 'self' data: blob: https:" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
